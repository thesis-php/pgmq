{
    "name": "thesis/pgmq",
    "description": "A non-blocking php client for Postgres Message Queue (PGMQ).",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.3",
        "amphp/amp": "^3.1",
        "amphp/pipeline": "^1.2",
        "amphp/postgres": "^2.1",
        "revolt/event-loop": "^1.0.7",
        "thesis/time-span": "^0.2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4.3",
        "symfony/var-dumper": "^6.4.15 || ^7.3.5"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Pgmq\\": "src/"
        },
        "files": [
            "src/pgmq.php",
            "src/Internal/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Pgmq\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
